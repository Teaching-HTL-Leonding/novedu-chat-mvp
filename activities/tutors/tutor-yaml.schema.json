{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Teaching-HTL-Leonding/novedu-chat-mvp/refs/heads/main/activities/tutors/tutor-yaml.schema.json",
  "title": "Tutor YAML or Fragment Library",
  "description": "Schema for tutor definition YAML files and reusable fragment library YAML files.",
  "oneOf": [
    {
      "$ref": "#/$defs/tutorFile"
    },
    {
      "$ref": "#/$defs/fragmentLibrary"
    }
  ],
  "$defs": {
    "tutorFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "llm", "prompt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Short machine-readable tutor id, e.g. fractions-de."
        },
        "name": {
          "type": "string",
          "description": "Human-readable tutor title."
        },
        "title": {
          "type": "string",
          "description": "Optional greeting shown to students on the empty chat instead of the default welcome message."
        },
        "description": {
          "type": "string",
          "description": "Short description of what this tutor does. Shown to students below the welcome greeting."
        },
        "exampleQuestions": {
          "type": "array",
          "description": "Optional example questions shown to students below the description on the empty chat. Clicking one puts the question text into the chat input. At most 5 are shown; with more, a random 5 are picked per page load.",
          "items": {
            "$ref": "#/$defs/exampleQuestion"
          }
        },
        "anonymous": {
          "type": "boolean",
          "default": true,
          "description": "Chats are anonymous by default: no link between the signed-in student and their chat is stored. Set to false to record which student each chat belongs to."
        },
        "llm": {
          "$ref": "#/$defs/llm"
        },
        "prompt": {
          "$ref": "#/$defs/prompt"
        }
      }
    },
    "exampleQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "question"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short clickable label shown on the welcome screen."
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "Full question text. Shown as a tooltip and placed into the chat input on click."
        }
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": {
          "type": "string",
          "description": "Model used for this tutor."
        },
        "provider": {
          "enum": ["SCCH", "Azure Foundry"],
          "default": "SCCH",
          "description": "The LLM provider serving the model. For Azure Foundry, model is the deployment name."
        },
        "imageInput": {
          "type": "boolean",
          "default": true,
          "description": "Image uploads are enabled by default. Set to false to hide the upload UI for text-only tutors or non-vision-capable models."
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tutor_instructions"],
      "properties": {
        "fragment_files": {
          "type": "array",
          "description": "Optional fragment libraries used by this tutor.",
          "items": {
            "$ref": "#/$defs/fragmentFileRef"
          },
          "default": []
        },
        "fragments": {
          "type": "array",
          "description": "Optional fragments selected from fragment_files.",
          "items": {
            "$ref": "#/$defs/fragmentRef"
          },
          "default": []
        },
        "tutor_instructions": {
          "type": "string",
          "description": "Final tutor-specific system-prompt instructions. For single-file tutors, this can be the whole prompt."
        }
      }
    },
    "fragmentFileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Local alias used by prompt.fragments[].file."
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "HTTP(S) URL or relative path to the fragment library.",
          "pattern": "^(https?://|(?![A-Za-z][A-Za-z0-9+.-]*:).+)$"
        }
      }
    },
    "fragmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "id"],
      "properties": {
        "file": {
          "type": "string",
          "description": "Alias from prompt.fragment_files[].id."
        },
        "id": {
          "type": "string",
          "description": "Fragment id inside the referenced library."
        },
        "variables": {
          "type": "object",
          "description": "Literal values passed into the fragment template.",
          "additionalProperties": {
            "$ref": "#/$defs/variableValue"
          }
        },
        "bind": {
          "type": "object",
          "description": "Accepted for compatibility but ignored by the current assembler.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean",
          "description": "Marker for important fragments. Accepted but not currently enforced."
        }
      }
    },
    "variableValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "fragmentLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fragments"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Machine-readable id of this fragment library."
        },
        "fragments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fragment"
          }
        }
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "priority", "content"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique fragment id within this library."
        },
        "version": {
          "type": "number",
          "description": "Fragment version number."
        },
        "priority": {
          "type": "number",
          "description": "Assembly order. Lower priorities appear earlier."
        },
        "input_schema": {
          "$ref": "#/$defs/inputSchema"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "content": {
          "type": "string",
          "description": "Prompt text as a Handlebars template."
        }
      }
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/inputProperty"
          },
          "default": {}
        }
      }
    },
    "inputProperty": {
      "oneOf": [
        {
          "$ref": "#/$defs/stringProperty"
        },
        {
          "$ref": "#/$defs/booleanProperty"
        },
        {
          "$ref": "#/$defs/stringArrayProperty"
        }
      ]
    },
    "stringProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "string"
        },
        "default": {
          "type": "string"
        }
      }
    },
    "booleanProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "default": {
          "type": "boolean"
        }
      }
    },
    "stringArrayProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {
          "const": "array"
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "string"
            }
          }
        },
        "default": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string"
        },
        "override_allowed": {
          "type": "boolean"
        }
      }
    }
  }
}
