---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";
import { micromark } from "micromark";
import { loadGlossary } from "../lib/glossary.ts";

// Guard: docsLoader silently yields an empty collection when src/content/docs is
// missing or broken. This page always builds, so the whole build fails loudly.
const docs = await getCollection("docs");
if (docs.length === 0) {
  throw new Error(
    "[teacher-docs-site] the docs collection is empty — is the src/content/docs symlink intact? It must point at ../teacher-docs/content (on Windows, enable Developer Mode or `git config core.symlinks true` and re-checkout)",
  );
}

const { entries } = loadGlossary();
const headings = entries.map((entry) => ({
  depth: 2,
  slug: entry.slug,
  text: entry.qualifier ? `${entry.term} ${entry.qualifier}` : entry.term,
}));
---

<StarlightPage
  frontmatter={{
    title: "Glossary",
    description: "Teacher-word to app-word map for the Novedu guide.",
    // StarlightPage validates against the extended docs schema, so the corpus's
    // required fields need values here too. This page is derived at render time
    // from teacher-docs/glossary.md, not a generated corpus file.
    audience: "teacher",
    keywords: ["glossary", "terms", "definitions"],
    generated: false,
  }}
  headings={headings}
>
  <p>
    Recurring terms of the guide. Chapters link a term the first time it appears; each
    entry below is the single definition those links point to.
  </p>
  {
    entries.map((entry) => (
      <>
        <h2 id={entry.slug}>
          {entry.term}
          {entry.qualifier && <small> {entry.qualifier}</small>}
        </h2>
        <Fragment set:html={micromark(entry.definition)} />
      </>
    ))
  }
</StarlightPage>
