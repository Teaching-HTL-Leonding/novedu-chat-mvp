{
  // The CLI's OWN tsc program, run by the root `npm run typecheck` (`tsc -p cli`).
  // It is deliberately separate from the root program: `next build` type-checks
  // the root tsconfig inside the Docker image, whose deps stage installs only the
  // root package.json — the cli workspace's devDeps (tsdown) don't exist there,
  // so cli files must never enter the app's program. The inherited `paths`
  // (`@/*`) re-anchor to the root tsconfig's directory, so `@/lib/tutors` keeps
  // resolving to the repo root.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "plugins": []
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.mts", "tsdown.config.ts"],
  "exclude": ["node_modules", "dist"]
}
