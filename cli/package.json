{
  "name": "@novedu/cli",
  "version": "0.9.0",
  "description": "Command-line companion for the Novedu chat app. Validates tutor, fragment, quiz, writing and coding YAML definitions; signs in with Entra ID and manages codes and app-hosted files over the app's API.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teaching-HTL-Leonding/novedu-chat-mvp.git",
    "directory": "cli"
  },
  "bin": {
    "novedu-cli": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.0",
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsdown": "^0.22.4"
  }
}
