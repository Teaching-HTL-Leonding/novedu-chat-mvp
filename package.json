{
  "name": "chat-prototype",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc -p cli --noEmit",
    "db:generate": "drizzle-kit generate",
    "generate:schemas": "tsx scripts/generate-activity-schemas.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert \"@live-llm|@live-storage\"",
    "test:e2e:db": "playwright test --grep @live-db",
    "test:e2e:storage": "playwright test --grep @live-storage",
    "test:e2e:ui": "playwright test --ui",
    "cli": "tsx cli/src/main.ts",
    "cli:build": "npm --workspace @novedu/cli run build",
    "test:cli": "npm run cli:build && vitest run --config cli/vitest.config.mts",
    "qa": "npm run check && npm run typecheck && npm run test && npm run build",
    "qa:e2e": "npm run qa && npm run test:e2e"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/mastra": "^1.1.1",
    "@azure/identity": "^4.13.1",
    "@azure/monitor-opentelemetry": "^1.18.2",
    "@azure/storage-blob": "^12.33.0",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@copilotkit/react-core": "^1.62.3",
    "@copilotkit/runtime": "^1.62.3",
    "@mastra/client-js": "^1.31.1",
    "@mastra/core": "^1.50.1",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.22.2",
    "@mastra/mssql": "^1.4.1",
    "@mastra/observability": "^1.16.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@uiw/react-codemirror": "^4.25.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-beta.22",
    "handlebars": "^4.7.9",
    "jose": "^6.2.3",
    "katex": "^0.17.0",
    "mssql": "^12.7.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.9.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@ag-ui/mastra": {
      "@copilotkit/runtime": "$@copilotkit/runtime"
    },
    "drizzle-orm": {
      "mssql": "$mssql",
      "@types/mssql": "$@types/mssql"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "drizzle-kit": "1.0.0-beta.22",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
