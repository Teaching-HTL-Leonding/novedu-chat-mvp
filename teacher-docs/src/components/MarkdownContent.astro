---
import { CardGrid, LinkCard } from "@astrojs/starlight/components";
import Default from "@astrojs/starlight/components/MarkdownContent.astro";
import { getEntry } from "astro:content";
import { withBase } from "../lib/paths.ts";

// Renders the frontmatter `related:` slugs as link cards after the chapter body.
const { entry } = Astro.locals.starlightRoute;
const related: string[] = entry?.data?.related ?? [];

const cards = await Promise.all(
  related.map(async (slug) => {
    const target = await getEntry("docs", slug);
    if (!target) {
      // Backstop for dev — the corpus-contract unit test is the primary check.
      throw new Error(
        `[teacher-docs] related: slug "${slug}" in chapter "${entry.id}" matches no chapter`,
      );
    }
    return { title: target.data.title, href: withBase(import.meta.env.BASE_URL, `${target.id}/`) };
  }),
);
---

<Default {...Astro.props}>
  <slot />
  {
    cards.length > 0 && (
      <>
        <h2 id="related-chapters">Related chapters</h2>
        <CardGrid>
          {cards.map((card) => (
            <LinkCard title={card.title} href={card.href} />
          ))}
        </CardGrid>
      </>
    )
  }
</Default>
